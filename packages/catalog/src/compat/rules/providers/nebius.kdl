// Nebius Token Factory: bundled metadata comes from the shared catalog plus the
// reference row seeded below; authenticated verbose discovery replaces the
// roster and deployment metadata.

provider "nebius" {
	// The serverless roster retired `DeepSeek-V4-Flash-0731` and the undated
	// `DeepSeek-V4.1-Flash` on 2026-11-12; the dated snapshot below is the public
	// Flash row now (`/v1/models?verbose=true`).
	default-model "deepseek-ai/DeepSeek-V4.1-Flash-1017"
	env "NEBIUS_API_KEY"
	dynamic-models-authoritative #true
	discovery label="Nebius Token Factory"

	// A credential-scoped provider's bundle is rebuilt from the shared catalog on
	// every regeneration (previous-snapshot rows are dropped), so a row the feed
	// retires would vanish and take `default-model` with it. This seed keeps one
	// public reference row bundled unconditionally; `precedence="upstream"` lets
	// the live feed's metadata win whenever the feed still lists the id.
	seed api="openai-completions" base-url="https://api.tokenfactory.nebius.com/v1" bundle="always" precedence="upstream" {
		model "deepseek-ai/DeepSeek-V4.1-Flash-1017" name="DeepSeek V4.1 Flash 1017" {
			reasoning #true
			input "text" "image"
			cost input=0.3 output=1.2 cache-read=0.006 cache-write=0
			limits context=1048576 max-tokens=1048576
		}
	}

	// Deployment effort vocabularies: catalog.stencil.so/models.json, 2026-10-23.
	// The verbose API omits these controls; lineage defaults are not host contracts.
	class "deepseek" {
		revision ">=4" {
			thinking-upgrade-neutral #true
			reasoning-disable-mode "none-effort"
		}
	}
	class "qwen" {
		revision "=3.8" {
			thinking-efforts "low" "medium" "xhigh"
			thinking-format "openai"
			thinking-upgrade-neutral #true
			reasoning-disable-mode "none-effort"
		}
	}
	class "glm" {
		revision "=5.2" {
			thinking-efforts "low" "medium" "high"
			thinking-upgrade-neutral #true
		}
		revision ">=5.3" {
			thinking-efforts "low" "high" "max"
			thinking-requires-effort #true
			thinking-upgrade-neutral #true
		}
	}
	// residue: taxonomy has no Nemotron class or revision that isolates these
	// deployments. Match the lineage inside deployment ids (`sa-example/...`)
	// as well as the serverless spelling.
	models "*nemotron-3_5-lightning*" "*nemotron-3.5-lightning*" \
		"nvidia/Nemotron-3-Ultra-550b-a55b" \
		"nvidia/Nemotron-3.5-Super-VL" {
		thinking-efforts "high"
		thinking-upgrade-neutral #true
		reasoning-disable-mode "none-effort"
	}
	// residue: taxonomy has no Hermes class. Measured 2026-11-08: the deployment
	// answers a vLLM `literal_error` naming `none`, `low`, `medium` and `high`
	// for every other tier, so the generic fallback ladder dispatched rejected
	// efforts (`minimal`, `xhigh`, `max` are 400s) and `lowest-effort` tried to
	// disable thinking with `minimal`. `none` is accepted and returns no
	// reasoning, so it is the off switch here too. The lineage glob also covers
	// a future dedicated deployment spelling.
	models "*hermes-4-405b*" {
		thinking-efforts "low" "medium" "high"
		thinking-upgrade-neutral #true
		reasoning-disable-mode "none-effort"
	}
	class "kimi" {
		family "k3" {
			thinking-efforts "low" "medium" "high" "max"
			reasoning-effort-map {}
			thinking-requires-effort #false
			thinking-upgrade-neutral #true
			reasoning-disable-mode "none-effort"
		}
	}
	// residue: taxonomy does not isolate these host-specific effort vocabularies.
	models "meta-models/muse-spark-open" {
		thinking-efforts "low" "medium" "high" "xhigh"
		thinking-upgrade-neutral #true
	}
	models "reflection/beam" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh" "max"
		thinking-upgrade-neutral #true
	}
}
